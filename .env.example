# The first dashboard account at /admin. Used only while the admins table is empty: the first sign-in with these
# creates the account, after which email and password are managed in the dashboard (Account tab).
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
# Secret for signing the admin session and salting visitor ids (required in production; defaults to ADMIN_PASSWORD).
ADMIN_SECRET=
# Optional: where uploads and article images live (default: ./data).
DATA_DIR=

# Public origin used in the sitemap and article share metadata
SITE_URL=https://hologram-alt.afdillah.com

# PostgreSQL. In Docker the web container gets DATABASE_URL from compose.yaml; for a laptop dev server,
# `docker compose up -d db` and point DATABASE_URL at the published port.
POSTGRES_PASSWORD=change-me
DB_PORT=5432
DATABASE_URL=postgres://hologram:change-me@127.0.0.1:5432/hologram
